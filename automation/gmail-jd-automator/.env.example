# Copy this file to .env and fill in your own values. Never commit .env.

# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Model used to write the tailored emails
CLAUDE_MODEL=claude-sonnet-5

# Path to your resume (PDF recommended). This exact file gets attached to every email.
RESUME_PATH=./my_resume.pdf

# "draft" (safe, default) creates new Gmail drafts for you to review and send manually.
# "send" sends the emails directly and immediately. Only switch this once you trust the output.
SEND_MODE=draft

# Optional: limit how many drafts are processed per run (0 = no limit). Start small, e.g. 3.
MAX_DRAFTS=3

# Optional signature lines appended to every generated email
YOUR_NAME=
YOUR_PHONE=
YOUR_LINKEDIN=

# ── Optional: NextApply Job Tracker Integration ──────────────────────────────
# When set, each processed draft is also logged as a Job record in the tracker.
# Leave blank to run the automator in standalone mode (no tracker sync).
NEXTAPPLY_API_URL=http://localhost:5089
NEXTAPPLY_API_KEY=dev-local-key
