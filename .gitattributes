# Set default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.js text
*.ts text
*.tsx text
*.jsx text
*.css text
*.json text
*.md text
*.html text

# Declare files that will always have LF line endings on checkout.
*.sh text eol=lf

# Denote all binary files to prevent git from attempting to convert line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.xlsx binary
*.xls binary
*.csv text
